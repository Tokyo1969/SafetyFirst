# Lokalnie skopiuj do .dev.vars (Cloudflare Workers) i uzupelnij.
# Na Cloudflare ustaw te same wartosci jako zmienne srodowiskowe/sekrety projektu.
SUPABASE_URL=https://rcizhcktflczrtadifwd.supabase.co
SUPABASE_ANON_KEY=
# Cloudflare Turnstile (antyspam formularza). Klucz witryny jest w src/config/site.ts (turnstileSiteKey).
# Sekret ustaw TYLKO jako sekret Workera (wrangler secret put TURNSTILE_SECRET_KEY lub panel Cloudflare), nie w wrangler.jsonc.
# Do testow lokalnych: klucz witryny 1x00000000000000000000AA i sekret 1x0000000000000000000000000000000AA (zawsze przechodzi).
TURNSTILE_SECRET_KEY=
