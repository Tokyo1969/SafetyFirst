# Lokalnie skopiuj do .dev.vars (Cloudflare Workers) i uzupelnij.
# Na Cloudflare ustaw te same wartosci jako zmienne srodowiskowe/sekrety projektu.
SUPABASE_URL=https://rcizhcktflczrtadifwd.supabase.co
SUPABASE_ANON_KEY=
# Cloudflare Turnstile (antyspam formularza). Klucz witryny jest w src/config/site.ts (turnstileSiteKey).
# Sekret ustaw TYLKO jako sekret Workera (wrangler secret put TURNSTILE_SECRET_KEY lub panel Cloudflare), nie w wrangler.jsonc.
# Do testow lokalnych: klucz witryny 1x00000000000000000000AA i sekret 1x0000000000000000000000000000000AA (zawsze przechodzi).
TURNSTILE_SECRET_KEY=
# Asystent AI na stronie (czat). Klucz API z platform.openai.com (osobny klucz dla tego projektu). TYLKO jako sekret
# Workera (wrangler secret put OPENAI_API_KEY lub panel Cloudflare), nigdy w wrangler.jsonc.
# W koncie OpenAI ustaw miesieczny limit wydatkow. Opcjonalnie CHAT_MODEL (domyslnie gpt-4.1-mini).
# CHAT_MOCK=1 w .dev.vars = odpowiedz testowa bez wywolania API.
OPENAI_API_KEY=
# Platnosci Stripe (Checkout). Klucz tajny z dashboard.stripe.com > Developers > API keys (w trybie testowym sk_test_...,
# najlepiej klucz ograniczony rk_test_ z uprawnieniem Checkout Sessions: Write). Sekret webhooka (whsec_...) z endpointu
# https://safetyfirst.opole.pl/api/stripe/webhook (zdarzenia checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired). Lokalnie: stripe listen --forward-to localhost:5173/api/stripe/webhook.
# Oba TYLKO jako sekrety Workera (wrangler secret put ...), nigdy w wrangler.jsonc.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Klucz serwisowy Supabase (sb_secret_... z Project Settings > API Keys). Serwer zapisuje nim zamowienia (orders,
# order_items), bo RLS pozwala klientom tylko czytac wlasne. TYLKO jako sekret Workera.
SUPABASE_SERVICE_ROLE_KEY=
